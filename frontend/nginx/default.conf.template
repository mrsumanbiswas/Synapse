# Rendered at container start by the nginx image (envsubst):
#   ${SYNAPSE_API_UPSTREAM}   host:port of the Synapse node this UI talks to
#   ${NGINX_LOCAL_RESOLVERS}  DNS server(s) from /etc/resolv.conf
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 512m;
    server_tokens off;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $synapse_api http://${SYNAPSE_API_UPSTREAM};

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        proxy_pass $synapse_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
