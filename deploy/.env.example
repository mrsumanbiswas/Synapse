# Settings for one laptop's node. Copy to deploy/.env and edit.

# A unique, short name for this node (shows up in document ids, e.g. "suman:3f9c...").
NODE_ID=suman
NODE_NAME=Suman's laptop

# This laptop's address on the shared network (find it with `ip addr` / `ipconfig`).
ADVERTISE_HOST=192.168.1.10

# At least one other node, host:port. The rest are discovered automatically.
PEERS=192.168.1.11:7000,192.168.1.12:7000

# Must be identical on every node: frames between peers are signed with it.
CLUSTER_SECRET=replace-with-a-long-random-string-shared-by-the-team

# Admin account created on first start (otherwise the first person to sign up becomes admin).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Import the bundled sample corpus on start. Do this on ONE laptop only: rendezvous
# hashing spreads the documents over every node that is online at that moment.
SEED_SAMPLE=false

# E-mail alerts. The default sends to the local Mailpit (http://localhost:8025).
# For real delivery, e.g. Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=true
# with an app password in SMTP_USER / SMTP_PASSWORD.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=Synapse <alerts@example.com>
